# MBOYO environment variables — copy to .env and fill in real values.
# NEVER commit .env. See AGENTS.md secrets/security rules.

# --- Core app ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_REPORTS_BUCKET=report-evidence
SUPABASE_EXPORTS_BUCKET=generated-exports

# --- ML API ---
ML_API_URL=http://localhost:8000
ML_INTERNAL_TOKEN=
# apps/ml-api-only: directory containing the exported model artifact
# (ml/src/training/export.py's <version>.onnx + <version>_metadata.json +
# active_version.txt) — see apps/ml-api/app/model_registry.py.
MODEL_ARTIFACT_DIR=models
# apps/ml-api-only: comma-separated browser Origin allowlist (empty means
# reject every browser-origin request — this service is never called from
# a browser, per docs/architecture/DEPLOYMENT_TOPOLOGY.md).
ALLOWED_ORIGINS=
# apps/ml-api-only: defense-in-depth per-client rate limit.
RATE_LIMIT_REQUESTS_PER_MINUTE=120
# apps/worker-only: identifies this worker instance in analysis_jobs.claimed_by
# and structured logs — defaults to a random id if unset.
WORKER_ID=

# --- Map ---
NEXT_PUBLIC_MAP_STYLE_URL=
MAPTILER_API_KEY=

# --- Security ---
SESSION_SIGNING_SECRET=
CRON_SECRET=

# --- Optional integrations (leave unset/false unless explicitly enabling) ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_ENABLED=false
# BLOCK 22 — Gemini verifier-advisory call tuning (all optional; the app
# works with zero Gemini configuration at all, per AGENTS.md/ADR 0004).
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_RETRIES=2
GEMINI_RATE_LIMIT_REQUESTS_PER_MINUTE=10
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com
RESEND_API_KEY=
EMAIL_FROM=

# --- Demo mode (see AGENTS.md demo fallback disclosure requirement) ---
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
